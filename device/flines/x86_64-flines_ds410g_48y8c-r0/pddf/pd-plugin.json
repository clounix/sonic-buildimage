      "i2c": {
        "valmap": {
          "1": true,
          "0": false
        }
      }
    },

    "psu_power_good": {
      "i2c": {
        "valmap": {
          "1": true,
          "0": false
        }
      }
    },

    "psu_fan_dir": {
