            "1": true,
            "1\n": true,
            "0": false,
            "0\n": false
        },
        "valmap-QSFP-DD": {
            "1": true,
            "1\n": true,
            "0": false,
            "0\n": false
        },
        "valmap-SFP": {
            "1": true,
            "1\n": true,
            "0": false,
            "0\n": false
        }
      }
    }

  },

  "PSU": {
